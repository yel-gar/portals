POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres
# Used by the backend to reach postgres; set by docker compose in production runs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
BACKEND_PORT=8000

# CORS origins — include both backend and frontend URLs when a frontend exists
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Set to 1/true to allow insecure cookies (non-Secure flag)
DEBUG=0

# Set to 1/true to disable the public registration endpoint (POST /auth/register -> 403)
DISABLE_REGISTRATION=0

# Set to 1/true to disable the portal simulator background loop. It runs in every
# mode (including DEBUG) by default; tests and CI set this to keep a clean DB.
DISABLE_SIMULATOR=0

# Creates/reconciles a single initial superuser at startup. Set both or neither.
# A superuser with a different name is deleted; a same-name superuser keeps its
# login but its password hash is updated when it differs from the configured one.
# A regular user holding the name aborts startup.
INITIAL_SUPERUSER_USERNAME=
INITIAL_SUPERUSER_PASSWORD=

# Chance (0..1) of the portal simulator opening a new portal on each 10-second tick.
# 0.05 means about one new portal every 3-4 minutes.
PORTAL_OPEN_CHANCE=0.05

# Optional: override the full database URL instead of assembling from POSTGRES_*
# DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/postgres

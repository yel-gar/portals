POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres
BACKEND_PORT=8000

# CORS origins — include both backend and frontend URLs when a frontend exists
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Set to 1/true to allow insecure cookies (non-Secure flag)
DEBUG=0

# Optional: override the full database URL instead of assembling from POSTGRES_*
# DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/postgres

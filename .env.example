POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres
# Used by the backend to reach postgres; set by docker compose in production runs
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
BACKEND_PORT=8000

# CORS origins — include both backend and frontend URLs when a frontend exists
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Set to 1/true to allow insecure cookies (non-Secure flag)
DEBUG=0

# Set to 1/true to disable the public registration endpoint (POST /auth/register -> 403)
DISABLE_REGISTRATION=0

# Creates/reconciles a single initial superuser at startup. Set both or neither.
# A superuser with a different name is deleted; a regular user holding the name aborts startup.
INITIAL_SUPERUSER_USERNAME=
INITIAL_SUPERUSER_PASSWORD=

# Optional: override the full database URL instead of assembling from POSTGRES_*
# DATABASE_URL=postgresql+asyncpg://postgres:change_me@localhost:5432/postgres
